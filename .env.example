# Copy to .env and fill in. Never commit .env.
TITAN_DB_PASSWORD=change-me
# This node's Tailscale IPv4 address (tailscale ip -4), or 127.0.0.1 for local development.
TITAN_TAILSCALE_IP=127.0.0.1
# Claude credential for chat: api-key (default) with ANTHROPIC_API_KEY, or oauth with
# CLAUDE_CODE_OAUTH_TOKEN for the owner's own subscription (see docs/architecture/claude-auth.md).
TITAN_CLAUDE_AUTH_MODE=api-key
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Scheduler: this node's name, and the node that fires reminders while it is up
# (the home server). Empty TITAN_PREFERRED_NODE means this node, right for one node.
TITAN_NODE_NAME=titan
TITAN_PREFERRED_NODE=
# Semantic search (ADR 0014): the model of the embeddings container, pinned by
# revision, the prefixes it expects, and the cosine distance beyond which a match
# is dropped (it differs per model). Change them together, on every node; the
# worker then embeds everything again. TITAN_EMBEDDINGS_URL= (empty) turns it off.
# Default preset: good retrieval across languages at about 140 ms a query and
# 2.2 GB of memory on 2 vCPU.
TITAN_EMBEDDINGS_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0
TITAN_EMBEDDINGS_REVISION=95c2741480856aa9666782eb4afe11959938017f
TITAN_EMBEDDINGS_QUERY_PREFIX="query: "
TITAN_EMBEDDINGS_DOCUMENT_PREFIX=""
TITAN_EMBEDDINGS_MAX_DISTANCE=0.8
# Best retrieval, for a node with memory and time to spare: about 320 ms a
# query, 3.3 GB, and indexing two and a half times slower.
# TITAN_EMBEDDINGS_MODEL=BAAI/bge-m3
# TITAN_EMBEDDINGS_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# TITAN_EMBEDDINGS_QUERY_PREFIX=""
# TITAN_EMBEDDINGS_DOCUMENT_PREFIX=""
# TITAN_EMBEDDINGS_MAX_DISTANCE=0.45
